FROM golang:1.27.0-alpine AS builder

# MinIO RELEASE.2025-10-15T17-29-55Z, pinned to its source commit.
RUN CGO_ENABLED=0 GOBIN=/out go install -trimpath -ldflags="-s -w" \
    github.com/minio/minio@v0.0.0-20251015172955-9e49d5e7a648

FROM alpine:3.23

RUN apk add --no-cache ca-certificates

COPY --from=builder /out/minio /usr/local/bin/minio

EXPOSE 9000 9001

ENTRYPOINT ["minio"]
CMD ["server", "/data"]
